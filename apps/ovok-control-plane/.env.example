# Control plane Postgres. Railway sets DATABASE_URL — also accepted as fallback.
CONTROL_PLANE_DATABASE_URL=postgres://control:control@localhost:5433/ovok_control_plane
# DATABASE_URL=

# Shared internal auth (must match PAYLOAD_INTERNAL_API_KEY on ovok-cms)
OVOK_INTERNAL_API_KEY=replace-with-shared-secret

# ovok-cms base URL for tenant provisioning
OVOK_CMS_URL=http://localhost:3000

PORT=4001
